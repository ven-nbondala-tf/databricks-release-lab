# Only needed to run scripts/deploy.sh from your own machine.
# Copy to .env and fill in. .env is ignored by git.
# In GitHub Actions these values come from environment secrets, not from this file.

DEV_DATABRICKS_HOST=https://your-dev-workspace.cloud.databricks.com
TEST_DATABRICKS_HOST=https://your-test-workspace.cloud.databricks.com
PROD_DATABRICKS_HOST=https://your-prod-workspace.cloud.databricks.com

# The access token is never stored in a file.
# For a local run, export DATABRICKS_TOKEN in your shell for that session only.
