{
  "datasets": [
    {
      "name": "sales_by_region",
      "displayName": "Sales by region",
      "queryLines": [
        "SELECT region, COUNT(*) AS orders, SUM(amount) AS revenue\n",
        "FROM <catalog>.dash_demo.sales\n",
        "WHERE amount >= :min_amount\n",
        "GROUP BY region"
      ],
      "parameters": [
        {
          "keyword": "min_amount",
          "displayName": "Minimum amount",
          "dataType": "INTEGER",
          "defaultSelection": {
            "values": {
              "dataType": "INTEGER",
              "values": [
                {
                  "value": "0"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "recent_orders",
      "displayName": "Recent orders",
      "queryLines": [
        "SELECT order_id, region, product, amount, order_date\n",
        "FROM <catalog>.dash_demo.sales\n",
        "ORDER BY order_date DESC, order_id DESC\n",
        "LIMIT 20"
      ]
    }
  ],
