# Copy this file to .env and fill in your own values.
# .env is ignored by git, so it never gets pushed.

# Your workspace URL, no trailing slash
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com

# A personal access token (User Settings > Developer > Access tokens)
DATABRICKS_TOKEN=

# Numeric workspace id. It is the number after ?o= in your workspace URL.
BUNDLE_VAR_workspace_id=

# Where the demo tables are created. Change these to a catalog you can write to.
BUNDLE_VAR_catalog=release_lab
BUNDLE_VAR_schema=jct_demo

# Use the direct deployment engine instead of terraform
DATABRICKS_BUNDLE_ENGINE=direct
